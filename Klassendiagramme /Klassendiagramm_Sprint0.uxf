<?xml version="1.0" encoding="UTF-8" standalone="no"?>
<diagram program="umlet" version="15.1">
  <zoom_level>10</zoom_level>

  <element>
    <id>UMLGeneric</id>
    <coordinates><x>40</x><y>80</y><w>240</w><h>160</h></coordinates>
    <panel_attributes>Kunde
--
+ name: str
+ adresse: str</panel_attributes>
    <additional_attributes/>
  </element>

  <element>
    <id>UMLGeneric</id>
    <coordinates><x>390</x><y>250</y><w>280</w><h>210</h></coordinates>
    <panel_attributes>Bestellung
--
+ bestellnummer: int
+ status: str
+ gericht_mengen: dict
--
+ hinzufuegen(gericht: Gericht, menge: int)
+ gesamtpreis(): float</panel_attributes>
    <additional_attributes/>
  </element>

  <element>
    <id>UMLGeneric</id>
    <coordinates><x>840</x><y>80</y><w>240</w><h>180</h></coordinates>
    <panel_attributes>Gericht
--
+ name: str
+ preis: float
+ vegetarisch: bool
--
+ get_preis(): float</panel_attributes>
    <additional_attributes/>
  </element>

  <element>
    <id>Relation</id>
    <coordinates><x>270</x><y>150</y><w>140</w><h>200</h></coordinates>
    <panel_attributes>lt=&lt;-
r1=+kunde</panel_attributes>
    <additional_attributes>10.0;10.0;120.0;180.0</additional_attributes>
  </element>

  <element>
    <id>Relation</id>
    <coordinates><x>660</x><y>150</y><w>200</w><h>200</h></coordinates>
    <panel_attributes>lt=-&gt;
r1=+gericht_mengen</panel_attributes>
    <additional_attributes>10.0;180.0;180.0;10.0</additional_attributes>
  </element>

  <element>
    <id>UMLGeneric</id>
    <coordinates><x>290</x><y>120</y><w>45</w><h>25</h></coordinates>
    <panel_attributes>1</panel_attributes>
    <additional_attributes/>
  </element>

  <element>
    <id>UMLGeneric</id>
    <coordinates><x>350</x><y>230</y><w>45</w><h>25</h></coordinates>
    <panel_attributes>0..*</panel_attributes>
    <additional_attributes/>
  </element>

  <element>
    <id>UMLGeneric</id>
    <coordinates><x>680</x><y>290</y><w>45</w><h>25</h></coordinates>
    <panel_attributes>0..*</panel_attributes>
    <additional_attributes/>
  </element>

  <element>
    <id>UMLGeneric</id>
    <coordinates><x>760</x><y>170</y><w>45</w><h>25</h></coordinates>
    <panel_attributes>0..*</panel_attributes>
    <additional_attributes/>
  </element>
</diagram>
